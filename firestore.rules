rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function jobAdmin() { return signedIn() && request.auth.token.email == 'lisaprajval@gmail.com' && request.auth.token.email_verified == true; }
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if jobAdmin()
        && request.resource.data.keys().hasOnly(['title','company','location','type','skills','description','createdBy','createdAt'])
        && request.resource.data.keys().hasAll(['title','company','location','skills','description','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if jobAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if jobAdmin();
    }
    // Applicant records and resume contents are sent to the Apps Script service.
    // Do not create public applicant collections in Firestore.
    match /applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.applicantId == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
